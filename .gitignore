# ========================================================
# Git Ignore Rules for AltiSignal
# Blocks all secrets, certificates, env files, and artifacts
# ========================================================

# Environment Variables & Secrets (NEVER COMMIT)
*.env
*.env.*
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
!.env.example
!**/.env.example

# Private Keys & Certificates
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.crt
*.cert
*.der
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Credentials, Service Accounts & API Keys
credentials.json
client_secret*.json
service-account*.json
firebase-adminsdk*.json
*secret*.json
*token*.json

# Mobile / Android App Secrets
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
local.properties
.gradle/
build/
android/app/build/
*.apk
*.aab

# Python / Django
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
*.log
local_settings.py
staticfiles/
media/
db.sqlite3
*.sqlite3

# Node / Next.js
node_modules/
.next/
out/
.pnp.*
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ML / Models
*.pkl
*.joblib
*.h5
*.onnx
models/saved/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# IDE & OS Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.tmp
