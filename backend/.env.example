# ==========================================
# AltiSignal - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the real .env file to git!
# ==========================================

# Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgis://altisignal:altisignal_dev@localhost:5432/altisignal

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS Allowed Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security (Set to True in production with HTTPS)
SECURE_SSL_REDIRECT=False

# Domain-specific settings
H3_RESOLUTION=8
LINK_LOSS_RSRP_THRESHOLD=-110
GAP_THRESHOLD_DBM=10
